{
  "manifest_version": 3,
  "name": "AI Productivity Tracker",
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://ai-productivity-tracker-backend.onrender.com"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}